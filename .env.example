# =============================================================================
# MiniSED — пример файла окружения.
# Скопируйте в .env и заполните реальными значениями.
# Файл .env в репозиторий НЕ коммитится (см. .gitignore).
# =============================================================================

# --- Базовое -----------------------------------------------------------------
# DEBUG=True только для локальной разработки. На сервере — False.
DEBUG=False

# Обязателен в продакшене. Сгенерировать:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# Домены, с которых открывается приложение (через запятую).
ALLOWED_HOSTS=127.0.0.1,localhost,msed.nordhotels.ru

# Доверенные источники для CSRF (со схемой https://, через запятую).
CSRF_TRUSTED_ORIGINS=https://msed.nordhotels.ru,https://hotelvedensky.bitrix24.ru

# Домены, которым разрешено встраивать MiniSED в iframe (CSP frame-ancestors).
FRAME_ANCESTORS='self',https://*.bitrix24.ru,https://*.bitrix24.com

# Часовой пояс.
TIME_ZONE=Europe/Moscow

# --- База данных -------------------------------------------------------------
# DB_ENGINE=sqlite   -> локальная разработка / промежуточный этап
# DB_ENGINE=postgres -> продакшн
DB_ENGINE=sqlite
DB_NAME=minised
DB_USER=minised
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- Безопасность (продакшн) -------------------------------------------------
# Обычно редиректом на HTTPS занимается nginx — оставьте False.
SECURE_SSL_REDIRECT=False
# HSTS включать только когда HTTPS стабильно работает на всех поддоменах.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# --- Почта -------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=True
DEFAULT_FROM_EMAIL=

# --- Битрикс24 ---------------------------------------------------------------
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=
BITRIX_OAUTH_AUTHORIZE_URL=https://oauth.bitrix.info/oauth/authorize
BITRIX_OAUTH_TOKEN_URL=https://oauth.bitrix.info/oauth/token
BITRIX_OAUTH_REDIRECT_PATH=https://msed.nordhotels.ru/app/

# --- Онлайн-редактирование документов (OnlyOffice / Р7-Офис) ------------------
# Пока сервер документов не развёрнут — оставьте DOCS_EDITOR_ENABLED=False:
# модель и эндпоинты присутствуют, но редактор не предлагается, callback закрыт.
DOCS_EDITOR_ENABLED=False
# onlyoffice | r7 — контракт одинаков, поле влияет только на подписи в UI.
DOCS_EDITOR_PROVIDER=onlyoffice
# База сервера документов, откуда фронт грузит api.js (напр. https://docs.internal).
DOCS_EDITOR_SERVER_URL=
# Общий секрет подписи JWT (тот же в конфиге сервера документов).
DOCS_EDITOR_JWT_SECRET=
# Адрес, по которому СЕРВЕР ДОКУМЕНТОВ достучится до MiniSED (скачивание+callback).
# В проде обычно ВНУТРЕННИЙ адрес, а не публичный периметр. Пусто → PUBLIC_BASE_URL.
DOCS_EDITOR_CALLBACK_BASE_URL=
# Прямой адрес сервера документов, по которому MiniSED СКАЧИВАЕТ результат
# (минуя внешний субпуть и self-signed TLS). Напр. http://127.0.0.1:8082
# Пусто → скачиваем по ссылке из callback как есть.
DOCS_EDITOR_INTERNAL_URL=
# Форматы для онлайн-редактирования (через запятую, без точки).
DOCS_EDITOR_EDITABLE_EXTS=docx,doc,odt,rtf,txt,xlsx,xls,ods,csv,pptx,ppt,odp
